# ─── Which platform to test ───────────────────────────────────────────────────
# Set to: nest | hubtel | route
GATEWAY_PLATFORM=nest

# Set to true to run all platforms that have credentials filled in below
# TEST_ALL=true

# ─── SMS Online GH / Nest ────────────────────────────────────────────────────
NEST_API_KEY=your_smsonlinegh_api_key_here
# NEST_HOST=api.smsonlinegh.com    # optional, this is the default
# NEST_PROTOCOL=https              # optional, this is the default

# ─── Hubtel ───────────────────────────────────────────────────────────────────
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret

# ─── Route Mobile ────────────────────────────────────────────────────────────
ROUTE_USERNAME=your_route_mobile_username
ROUTE_PASSWORD=your_route_mobile_password
# ROUTE_HOST=rslr.connectbind.com  # optional, this is the default
# ROUTE_PORT=8080                  # optional, this is the default
# ROUTE_PROTOCOL=http              # optional, this is the default

# ─── Live send (opt-in) ───────────────────────────────────────────────────────
# Set TEST_SEND=true to actually send an SMS during the test.
# Without it, only init and balance checks run (safe / non-destructive).
# TEST_SEND=true
# TEST_FROM=SenderName
# TEST_TO=+233XXXXXXXXX
# TEST_CONTENT=unismsgateway live test — please ignore.
